# Скопируйте в .env на сервере и заполните. Файл .env НИКОГДА не коммитим.

APP_DOMAIN=app.alpha-prime.group
PUBLIC_URL=https://app.alpha-prime.group
SECRET_KEY=            # длинная случайная строка: openssl rand -hex 32
POSTGRES_PASSWORD=     # openssl rand -hex 16
ADMIN_PASSWORD=        # пароль входа в админку /admin

# Telegram-бот (от @BotFather)
BOT_TOKEN=
BOT_USERNAME=          # без @, например AlphaPrimeBot

# Kommo (долгосрочный токен приватной интеграции)
KOMMO_BASE_URL=https://baliprimeconsalting.kommo.com
KOMMO_TOKEN=
KOMMO_MOCK=false       # true — тестовые данные вместо CRM

# Контакты компании в приложении
COMPANY_WHATSAPP=628113979669
COMPANY_TELEGRAM=      # ник без @
COMPANY_INSTAGRAM=     # ник без @

DEV_MODE=false         # true только для разработки!

# Telegram-группа менеджеров для уведомлений о заявках (узнать: добавьте бота в группу и напишите /chatid)
MANAGERS_CHAT_ID=
