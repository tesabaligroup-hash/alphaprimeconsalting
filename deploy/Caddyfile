# HTTPS-сертификат Caddy получает и продлевает сам (Let's Encrypt)
{$APP_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body /admin/* {
		max_size 10MB
	}
	reverse_proxy api:8000
}

# «Мир Августины» — детское приложение (статичные файлы из kids/) + его сервер kids-api
{$KIDS_DOMAIN:kids.alpha-prime.group} {
	encode gzip
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy kids-api:8000
	}
	handle {
		root * /srv/kids
		file_server
		@html path / /index.html
		header @html Cache-Control "no-cache"
	}
}
